{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# NPC → Layer V ET Trajectory Sync Analysis\n",
    "## Pre-mitotic vs Post-mitotic Identity Gene Classification\n",
    "\n",
    "**Logic:**\n",
    "- Genes synced between NPC and Layer V ET trajectories → **pre-mitotic identity** (inherited from progenitor)\n",
    "- Genes with slight delay (lag ≤ 1 timepoint) → **delayed pre-mitotic** (transcriptional lag)\n",
    "- Genes out of sync → **post-mitotic identity** (established after cell cycle exit)\n",
    "\n",
    "**Sync decomposition:**\n",
    "```\n",
    "RNA✅ ATAC✅ → Fully pre-mitotic\n",
    "RNA✅ ATAC❌ → Transcription pre-mitotic, chromatin post-mitotic (TF forcing RNA)\n",
    "RNA❌ ATAC✅ → Chromatin pre-mitotic, transcription post-mitotic\n",
    "RNA❌ ATAC❌ → Fully post-mitotic\n",
    "```\n",
    "\n",
    "**Dataset:** Motor Cortex 10X scRNA-seq (E10.5 → P4)  \n",
    "**Timepoints of interest:** E10.5 → E15.5 (deep layer neurogenesis window)  \n",
    "**Hamming tolerance:** ≤ 1/6 per timepoint comparison  \n",
    "**Lag tolerance:** 0, 1, 2 timepoint shifts tested"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import scanpy as sc\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import scipy.io\n",
    "import gzip\n",
    "from pathlib import Path\n",
    "from scipy.stats import zscore, percentileofscore\n",
    "from scipy.sparse import issparse\n",
    "\n",
    "sc.settings.verbosity = 1\n",
    "pd.set_option('display.max_columns', 20)\n",
    "pd.set_option('display.max_rows', 60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Paths ─────────────────────────────────────────────────────────────────────\n",
    "CORTEX_RNA_DIR = Path(\"/home/nakagawa/datasets/aligned_cortex\")\n",
    "OUT_DIR        = Path(\"/home/nakagawa/datasets/npc_sync_results\")\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ── Timepoints (deep layer neurogenesis window) ───────────────────────────────\n",
    "# Full cortex timepoints available\n",
    "ALL_TIMEPOINTS  = [\"E11.5\", \"E12.5\", \"E13.5\", \"E14.5\", \"E15.5\", \"E16.5\",\n",
    "                   \"E18.5\", \"P1\", \"P4\"]\n",
    "# Window for NPC→LayerVET sync analysis\n",
    "SYNC_TIMEPOINTS = [\"E11.5\", \"E12.5\", \"E13.5\", \"E14.5\", \"E15.5\", \"E16.5\"]\n",
    "\n",
    "# ── Score-based cell type identification ─────────────────────────────────────\n",
    "# Apical radial glia / NPC markers\n",
    "NPC_MARKERS = {\n",
    "    \"positive\": [\"Sox2\", \"Pax6\", \"Nes\", \"Vim\", \"Top2a\", \"Mki67\", \"Pcna\",\n",
    "                 \"Cenpf\", \"Hmgb2\"],\n",
    "    \"negative\": [\"Tbr1\", \"Bcl11b\", \"Satb2\", \"Neurod2\", \"Map2\"]\n",
    "}\n",
    "\n",
    "# Layer V ET markers\n",
    "LVET_MARKERS = {\n",
    "    \"positive\": [\"Bcl11b\", \"Fezf2\", \"Tbr1\", \"Rorb\", \"Crym\", \"Syt6\"],\n",
    "    \"negative\": [\"Sox2\", \"Mki67\", \"Satb2\", \"Cux1\", \"Cux2\"]\n",
    "}\n",
    "\n",
    "# Top quartile threshold for cell selection\n",
    "SCORE_PERCENTILE = 75   # cells above 75th percentile score = high-confidence\n",
    "\n",
    "# ── Trajectory parameters ─────────────────────────────────────────────────────\n",
    "PERCENTILES    = [50, 75]     # RNA threshold sensitivity check\n",
    "MAX_LAG        = 2            # max timepoint shift to test for delayed sync\n",
    "# Hamming: 1/6 of 6 timepoints = 1\n",
    "MAX_HAMMING    = 1\n",
    "\n",
    "print(\"Configuration set.\")\n",
    "print(f\"Sync window    : {SYNC_TIMEPOINTS}\")\n",
    "print(f\"Max Hamming    : ≤{MAX_HAMMING}/{len(SYNC_TIMEPOINTS)}\")\n",
    "print(f\"Max lag tested : {MAX_LAG} timepoints\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load STARsolo Count Matrices Per Timepoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SRR to timepoint mapping (from alignment script)\n",
    "SRR_TO_TP = {\n",
    "    \"SRR12082755\": \"E11.5\",\n",
    "    \"SRR12082756\": \"E12.5\",\n",
    "    \"SRR12082757\": \"E13.5\",\n",
    "    \"SRR12082758\": \"E14.5\",\n",
    "    \"SRR12082759\": \"E15.5\",\n",
    "    \"SRR12082760\": \"E16.5\",\n",
    "    \"SRR12082761\": \"E18.5\",\n",
    "    \"SRR12082762\": \"E18.5b\",\n",
    "    \"SRR12082763\": \"P1\",\n",
    "    \"SRR12082764\": \"P1b\",\n",
    "    \"SRR14407605\": \"P4\",\n",
    "    \"SRR14407606\": \"P4b\",\n",
    "    \"SRR14407607\": \"P4c\",\n",
    "}\n",
    "\n",
    "def load_starsolo(sample_dir):\n",
    "    \"\"\"Load STARsolo filtered matrix → AnnData.\"\"\"\n",
    "    mtx_path = Path(sample_dir) / \"Solo.out/GeneFull/filtered\"\n",
    "    mat      = scipy.io.mmread(mtx_path / \"matrix.mtx.gz\").T.tocsr()\n",
    "    with gzip.open(mtx_path / \"features.tsv.gz\", \"rt\") as f:\n",
    "        genes    = [l.strip().split(\"\\t\")[1] for l in f]\n",
    "    with gzip.open(mtx_path / \"barcodes.tsv.gz\", \"rt\") as f:\n",
    "        barcodes = [l.strip() for l in f]\n",
    "    adata = sc.AnnData(\n",
    "        X    = mat,\n",
    "        obs  = pd.DataFrame(index=barcodes),\n",
    "        var  = pd.DataFrame(index=genes)\n",
    "    )\n",
    "    return adata\n",
    "\n",
    "\n",
    "print(\"Scanning aligned_cortex for STARsolo outputs...\")\n",
    "tp_to_adata = {}   # {timepoint: AnnData}\n",
    "\n",
    "for sample_dir in sorted(CORTEX_RNA_DIR.iterdir()):\n",
    "    if not sample_dir.is_dir(): continue\n",
    "    mtx = sample_dir / \"Solo.out/GeneFull/filtered/matrix.mtx.gz\"\n",
    "    if not mtx.exists(): continue\n",
    "\n",
    "    # Match SRR from directory name\n",
    "    srr = None\n",
    "    for s in SRR_TO_TP:\n",
    "        if s in sample_dir.name:\n",
    "            srr = s\n",
    "            break\n",
    "    if srr is None:\n",
    "        print(f\"  [SKIP] Cannot identify SRR: {sample_dir.name}\")\n",
    "        continue\n",
    "\n",
    "    tp = SRR_TO_TP[srr]\n",
    "    if tp not in SYNC_TIMEPOINTS + [\"E18.5\", \"P1\", \"P4\"]:\n",
    "        continue\n",
    "\n",
    "    print(f\"  Loading {sample_dir.name} → {tp}...\")\n",
    "    adata       = load_starsolo(sample_dir)\n",
    "    adata.obs[\"timepoint\"] = tp\n",
    "    adata.obs[\"SRR\"]       = srr\n",
    "\n",
    "    # Merge replicates of same timepoint\n",
    "    if tp in tp_to_adata:\n",
    "        tp_to_adata[tp] = sc.concat(\n",
    "            [tp_to_adata[tp], adata],\n",
    "            join=\"outer\", fill_value=0\n",
    "        )\n",
    "    else:\n",
    "        tp_to_adata[tp] = adata\n",
    "\n",
    "    print(f\"    {adata.n_obs} cells x {adata.n_vars} genes\")\n",
    "\n",
    "print(f\"\\nTimepoints loaded: {sorted(tp_to_adata.keys())}\")\n",
    "missing = [t for t in SYNC_TIMEPOINTS if t not in tp_to_adata]\n",
    "if missing:\n",
    "    print(f\"[WARNING] Missing: {missing} — alignment may still be running\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Basic QC Per Timepoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Running QC per timepoint...\")\n",
    "for tp, adata in tp_to_adata.items():\n",
    "    sc.pp.filter_cells(adata, min_genes=200)\n",
    "    sc.pp.filter_genes(adata, min_cells=3)\n",
    "\n",
    "    # Mitochondrial QC\n",
    "    adata.var[\"mt\"] = adata.var_names.str.startswith(\"mt-\")\n",
    "    sc.pp.calculate_qc_metrics(\n",
    "        adata, qc_vars=[\"mt\"], percent_top=None, log1p=False, inplace=True\n",
    "    )\n",
    "    # Filter high MT cells (likely dead)\n",
    "    before = adata.n_obs\n",
    "    adata  = adata[adata.obs[\"pct_counts_mt\"] < 20].copy()\n",
    "    tp_to_adata[tp] = adata\n",
    "    print(f\"  {tp}: {before} → {adata.n_obs} cells after QC  \"\n",
    "          f\"({adata.n_vars} genes)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Score-Based NPC and Layer V ET Identification\n",
    "\n",
    "For each cell compute:\n",
    "```\n",
    "NPC_score  = mean(Z_score of positive markers) - mean(Z_score of negative markers)\n",
    "LVET_score = mean(Z_score of positive markers) - mean(Z_score of negative markers)\n",
    "```\n",
    "Cells above 75th percentile of their respective score = high-confidence population."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_cell_score(adata, pos_markers, neg_markers):\n",
    "    \"\"\"\n",
    "    Score each cell based on marker gene expression.\n",
    "    Uses log-normalized expression Z-scored across cells.\n",
    "    Returns Series: cell barcode → score.\n",
    "    \"\"\"\n",
    "    # Work on log-normalized copy\n",
    "    a = adata.copy()\n",
    "    sc.pp.normalize_total(a, target_sum=1e4)\n",
    "    sc.pp.log1p(a)\n",
    "\n",
    "    X = a.X.toarray() if issparse(a.X) else np.array(a.X)\n",
    "    df = pd.DataFrame(X, index=a.obs_names, columns=a.var_names)\n",
    "\n",
    "    # Z-score across cells per gene\n",
    "    df_z = df.apply(zscore, axis=0, nan_policy='omit').fillna(0)\n",
    "\n",
    "    # Positive contribution\n",
    "    pos_avail = [g for g in pos_markers if g in df_z.columns]\n",
    "    neg_avail = [g for g in neg_markers if g in df_z.columns]\n",
    "\n",
    "    pos_score = df_z[pos_avail].mean(axis=1) if pos_avail else pd.Series(0, index=df_z.index)\n",
    "    neg_score = df_z[neg_avail].mean(axis=1) if neg_avail else pd.Series(0, index=df_z.index)\n",
    "\n",
    "    score = pos_score - neg_score\n",
    "\n",
    "    missing_pos = [g for g in pos_markers if g not in df_z.columns]\n",
    "    missing_neg = [g for g in neg_markers if g not in df_z.columns]\n",
    "    if missing_pos: print(f\"    [NOTE] Positive markers not in data: {missing_pos}\")\n",
    "    if missing_neg: print(f\"    [NOTE] Negative markers not in data: {missing_neg}\")\n",
    "\n",
    "    return score\n",
    "\n",
    "\n",
    "print(\"Computing NPC and Layer V ET scores per timepoint...\\n\")\n",
    "\n",
    "npc_cells  = {}   # {timepoint: list of barcode indices}\n",
    "lvet_cells = {}   # {timepoint: list of barcode indices}\n",
    "\n",
    "score_summary = []\n",
    "\n",
    "for tp in SYNC_TIMEPOINTS + [\"E18.5\", \"P1\", \"P4\"]:\n",
    "    if tp not in tp_to_adata: continue\n",
    "    adata = tp_to_adata[tp]\n",
    "    print(f\"--- {tp} ({adata.n_obs} cells) ---\")\n",
    "\n",
    "    # Compute scores\n",
    "    npc_score  = compute_cell_score(\n",
    "        adata, NPC_MARKERS[\"positive\"], NPC_MARKERS[\"negative\"]\n",
    "    )\n",
    "    lvet_score = compute_cell_score(\n",
    "        adata, LVET_MARKERS[\"positive\"], LVET_MARKERS[\"negative\"]\n",
    "    )\n",
    "\n",
    "    # Store scores in adata\n",
    "    adata.obs[\"npc_score\"]  = npc_score.values\n",
    "    adata.obs[\"lvet_score\"] = lvet_score.values\n",
    "\n",
    "    # Select top SCORE_PERCENTILE cells for each population\n",
    "    npc_thresh  = np.percentile(npc_score,  SCORE_PERCENTILE)\n",
    "    lvet_thresh = np.percentile(lvet_score, SCORE_PERCENTILE)\n",
    "\n",
    "    npc_mask  = (npc_score  >= npc_thresh)  & (lvet_score < np.percentile(lvet_score, 50))\n",
    "    lvet_mask = (lvet_score >= lvet_thresh) & (npc_score  < np.percentile(npc_score,  50))\n",
    "\n",
    "    npc_cells[tp]  = adata.obs_names[npc_mask].tolist()\n",
    "    lvet_cells[tp] = adata.obs_names[lvet_mask].tolist()\n",
    "\n",
    "    print(f\"  NPC  score thresh={npc_thresh:.2f}  → {npc_mask.sum()} high-confidence NPC cells\")\n",
    "    print(f\"  LVET score thresh={lvet_thresh:.2f} → {lvet_mask.sum()} high-confidence LVET cells\")\n",
    "\n",
    "    score_summary.append({\n",
    "        \"timepoint\": tp,\n",
    "        \"total_cells\": adata.n_obs,\n",
    "        \"npc_cells\": npc_mask.sum(),\n",
    "        \"lvet_cells\": lvet_mask.sum(),\n",
    "        \"npc_thresh\": round(npc_thresh, 3),\n",
    "        \"lvet_thresh\": round(lvet_thresh, 3),\n",
    "    })\n",
    "\n",
    "summary_df = pd.DataFrame(score_summary)\n",
    "print(\"\\n--- Score Summary ---\")\n",
    "display(summary_df)\n",
    "summary_df.to_csv(OUT_DIR / \"cell_score_summary.csv\", index=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Marker Expression Validation\n",
    "Sanity check — confirm scores reflect actual marker expression."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check mean expression of key markers in NPC vs LVET cells at E13.5\n",
    "# (peak of deep layer neurogenesis)\n",
    "CHECK_TP = \"E13.5\"\n",
    "\n",
    "if CHECK_TP in tp_to_adata:\n",
    "    adata = tp_to_adata[CHECK_TP]\n",
    "    sc.pp.normalize_total(adata, target_sum=1e4)\n",
    "    sc.pp.log1p(adata)\n",
    "\n",
    "    check_genes = list(set(\n",
    "        NPC_MARKERS[\"positive\"] + NPC_MARKERS[\"negative\"] +\n",
    "        LVET_MARKERS[\"positive\"] + LVET_MARKERS[\"negative\"]\n",
    "    ))\n",
    "    check_genes = [g for g in check_genes if g in adata.var_names]\n",
    "\n",
    "    X = adata.X.toarray() if issparse(adata.X) else np.array(adata.X)\n",
    "    expr_df = pd.DataFrame(X, index=adata.obs_names, columns=adata.var_names)\n",
    "\n",
    "    npc_bc  = npc_cells.get(CHECK_TP, [])\n",
    "    lvet_bc = lvet_cells.get(CHECK_TP, [])\n",
    "\n",
    "    rows = []\n",
    "    for gene in check_genes:\n",
    "        npc_mean  = expr_df.loc[npc_bc,  gene].mean() if npc_bc  else np.nan\n",
    "        lvet_mean = expr_df.loc[lvet_bc, gene].mean() if lvet_bc else np.nan\n",
    "        role = \"NPC+\" if gene in NPC_MARKERS[\"positive\"] else \\\n",
    "               \"NPC-\" if gene in NPC_MARKERS[\"negative\"] else \\\n",
    "               \"LVET+\" if gene in LVET_MARKERS[\"positive\"] else \"LVET-\"\n",
    "        rows.append({\n",
    "            \"gene\": gene, \"role\": role,\n",
    "            \"mean_in_NPC\": round(npc_mean, 3),\n",
    "            \"mean_in_LVET\": round(lvet_mean, 3),\n",
    "            \"ratio_NPC_LVET\": round(npc_mean / (lvet_mean + 0.01), 2)\n",
    "        })\n",
    "\n",
    "    val_df = pd.DataFrame(rows).sort_values(\"role\")\n",
    "    display(val_df)\n",
    "    val_df.to_csv(OUT_DIR / \"marker_validation.csv\", index=False)\n",
    "\n",
    "    print(\"\\n[CHECK] NPC+ markers should have ratio >> 1\")\n",
    "    print(\"[CHECK] LVET+ markers should have ratio << 1\")\n",
    "    print(\"If ratios are reversed, swap scores or adjust marker lists in Cell 0.\")\n",
    "else:\n",
    "    print(f\"{CHECK_TP} not loaded yet.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Build Pseudobulk RNA Per Population Per Timepoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def pseudobulk_cpm(adata, barcode_list):\n",
    "    \"\"\"\n",
    "    Sum raw counts for selected barcodes, CPM normalize.\n",
    "    Returns Series: gene → CPM.\n",
    "    \"\"\"\n",
    "    if not barcode_list:\n",
    "        return pd.Series(dtype=float)\n",
    "    sub  = adata[barcode_list]\n",
    "    X    = sub.X.toarray() if issparse(sub.X) else np.array(sub.X)\n",
    "    sums = X.sum(axis=0)\n",
    "    total = sums.sum()\n",
    "    if total == 0:\n",
    "        return pd.Series(np.zeros(len(sub.var_names)), index=sub.var_names)\n",
    "    cpm = sums / total * 1e6\n",
    "    return pd.Series(cpm, index=sub.var_names)\n",
    "\n",
    "\n",
    "print(\"Building pseudobulk matrices...\")\n",
    "\n",
    "npc_pb  = {}   # {timepoint: Series(gene → CPM)}\n",
    "lvet_pb = {}   # {timepoint: Series(gene → CPM)}\n",
    "\n",
    "for tp in SYNC_TIMEPOINTS:\n",
    "    if tp not in tp_to_adata: continue\n",
    "\n",
    "    # Use raw counts (reload before normalization)\n",
    "    adata = tp_to_adata[tp]\n",
    "\n",
    "    npc_pb[tp]  = pseudobulk_cpm(adata, npc_cells.get(tp, []))\n",
    "    lvet_pb[tp] = pseudobulk_cpm(adata, lvet_cells.get(tp, []))\n",
    "\n",
    "    print(f\"  {tp}: NPC={len(npc_cells.get(tp,[]))} cells, \"\n",
    "          f\"LVET={len(lvet_cells.get(tp,[]))} cells\")\n",
    "\n",
    "# Build matrices: genes x timepoints\n",
    "npc_matrix  = pd.DataFrame(npc_pb).fillna(0)\n",
    "lvet_matrix = pd.DataFrame(lvet_pb).fillna(0)\n",
    "\n",
    "# Align to common genes\n",
    "common_genes = npc_matrix.index.intersection(lvet_matrix.index)\n",
    "npc_matrix   = npc_matrix.loc[common_genes]\n",
    "lvet_matrix  = lvet_matrix.loc[common_genes]\n",
    "\n",
    "print(f\"\\nNPC  matrix : {npc_matrix.shape}  (genes x timepoints)\")\n",
    "print(f\"LVET matrix : {lvet_matrix.shape}  (genes x timepoints)\")\n",
    "print(f\"Common genes: {len(common_genes)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Assign RNA Trajectory States\n",
    "Binary high/low call per gene per timepoint, at both 50th and 75th percentile."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def binarize_matrix(mat, percentile, timepoints):\n",
    "    \"\"\"\n",
    "    For each gene at each timepoint, call HIGH (1) or LOW (0)\n",
    "    based on percentile rank across all genes at that timepoint.\n",
    "    Returns DataFrame: genes x timepoints, values 0 or 1.\n",
    "    \"\"\"\n",
    "    result = pd.DataFrame(index=mat.index, columns=timepoints, dtype=int)\n",
    "    for tp in timepoints:\n",
    "        if tp not in mat.columns:\n",
    "            result[tp] = np.nan\n",
    "            continue\n",
    "        thresh = np.percentile(mat[tp], percentile)\n",
    "        result[tp] = (mat[tp] >= thresh).astype(int)\n",
    "    return result\n",
    "\n",
    "\n",
    "available_tp = [t for t in SYNC_TIMEPOINTS if t in npc_matrix.columns\n",
    "                and t in lvet_matrix.columns]\n",
    "print(f\"Available sync timepoints: {available_tp}\")\n",
    "\n",
    "binary = {}   # {percentile: {\"npc\": df, \"lvet\": df}}\n",
    "\n",
    "for pct in PERCENTILES:\n",
    "    binary[pct] = {\n",
    "        \"npc\" : binarize_matrix(npc_matrix,  pct, available_tp),\n",
    "        \"lvet\": binarize_matrix(lvet_matrix, pct, available_tp),\n",
    "    }\n",
    "    n_high_npc  = (binary[pct][\"npc\"]  == 1).sum().sum()\n",
    "    n_high_lvet = (binary[pct][\"lvet\"] == 1).sum().sum()\n",
    "    print(f\"pct={pct}: NPC high calls={n_high_npc}, LVET high calls={n_high_lvet}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Compute Trajectory Sync with Lag Testing\n",
    "\n",
    "For each gene:\n",
    "1. Compare NPC and LVET trajectories at lag=0,1,2\n",
    "2. Find minimum Hamming distance across lags\n",
    "3. Classify sync type"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def hamming(t1, t2):\n",
    "    \"\"\"Hamming distance between two equal-length tuples.\"\"\"\n",
    "    return sum(a != b for a, b in zip(t1, t2))\n",
    "\n",
    "\n",
    "def test_lag_sync(npc_traj, lvet_traj, max_lag, max_hamming):\n",
    "    \"\"\"\n",
    "    Test if NPC trajectory leads LVET trajectory by 0..max_lag timepoints.\n",
    "    NPC leads = NPC state at t matches LVET state at t+lag.\n",
    "\n",
    "    Returns:\n",
    "        best_lag      : lag at minimum Hamming distance (-1 if never synced)\n",
    "        best_hamming  : minimum Hamming distance found\n",
    "        is_synced     : True if best_hamming <= max_hamming\n",
    "        sync_type     : 'IMMEDIATE' / 'DELAYED_1' / 'DELAYED_2' / 'ASYNC'\n",
    "    \"\"\"\n",
    "    n = len(lvet_traj)\n",
    "    best_h   = n + 1\n",
    "    best_lag = -1\n",
    "\n",
    "    for lag in range(max_lag + 1):\n",
    "        # Compare NPC[0:n-lag] with LVET[lag:n]\n",
    "        if n - lag < 2: continue   # too short to compare\n",
    "        npc_sub  = npc_traj[:n - lag]\n",
    "        lvet_sub = lvet_traj[lag:]\n",
    "        h = hamming(npc_sub, lvet_sub)\n",
    "        # Normalize by comparison length\n",
    "        if h < best_h:\n",
    "            best_h   = h\n",
    "            best_lag = lag\n",
    "\n",
    "    is_synced = best_h <= max_hamming\n",
    "\n",
    "    if not is_synced:\n",
    "        sync_type = \"ASYNC\"\n",
    "    elif best_lag == 0:\n",
    "        sync_type = \"IMMEDIATE\"\n",
    "    else:\n",
    "        sync_type = f\"DELAYED_{best_lag}\"\n",
    "\n",
    "    return best_lag, best_h, is_synced, sync_type\n",
    "\n",
    "\n",
    "print(\"Computing trajectory sync...\\n\")\n",
    "sync_results = {}   # {percentile: DataFrame}\n",
    "\n",
    "for pct in PERCENTILES:\n",
    "    npc_bin  = binary[pct][\"npc\"].dropna()\n",
    "    lvet_bin = binary[pct][\"lvet\"].dropna()\n",
    "    common   = npc_bin.index.intersection(lvet_bin.index)\n",
    "\n",
    "    rows = []\n",
    "    for gene in common:\n",
    "        npc_traj  = tuple(int(v) for v in npc_bin.loc[gene,  available_tp])\n",
    "        lvet_traj = tuple(int(v) for v in lvet_bin.loc[gene, available_tp])\n",
    "\n",
    "        best_lag, best_h, is_synced, sync_type = test_lag_sync(\n",
    "            npc_traj, lvet_traj, MAX_LAG, MAX_HAMMING\n",
    "        )\n",
    "\n",
    "        # Additional flags\n",
    "        npc_transitions  = sum(npc_traj[i]  != npc_traj[i+1]\n",
    "                               for i in range(len(npc_traj)-1))\n",
    "        lvet_transitions = sum(lvet_traj[i] != lvet_traj[i+1]\n",
    "                               for i in range(len(lvet_traj)-1))\n",
    "        is_dynamic = npc_transitions > 0 or lvet_transitions > 0\n",
    "\n",
    "        # Classify pre/post mitotic\n",
    "        if sync_type == \"IMMEDIATE\":\n",
    "            mitotic_class = \"PRE_MITOTIC\"\n",
    "        elif sync_type.startswith(\"DELAYED\"):\n",
    "            mitotic_class = \"DELAYED_PRE_MITOTIC\"\n",
    "        else:\n",
    "            mitotic_class = \"POST_MITOTIC\"\n",
    "\n",
    "        rows.append({\n",
    "            \"gene\"            : gene,\n",
    "            \"npc_trajectory\"  : \"→\".join(str(s) for s in npc_traj),\n",
    "            \"lvet_trajectory\" : \"→\".join(str(s) for s in lvet_traj),\n",
    "            \"sync_type\"       : sync_type,\n",
    "            \"mitotic_class\"   : mitotic_class,\n",
    "            \"best_lag\"        : best_lag,\n",
    "            \"best_hamming\"    : best_h,\n",
    "            \"is_synced\"       : is_synced,\n",
    "            \"is_dynamic\"      : is_dynamic,\n",
    "            \"npc_transitions\" : npc_transitions,\n",
    "            \"lvet_transitions\": lvet_transitions,\n",
    "            \"percentile\"      : pct,\n",
    "        })\n",
    "\n",
    "    df = pd.DataFrame(rows)\n",
    "    sync_results[pct] = df\n",
    "\n",
    "    print(f\"pct={pct}th percentile threshold:\")\n",
    "    print(df[\"sync_type\"].value_counts().to_string())\n",
    "    print(f\"\\nDynamic genes (any transition): {df['is_dynamic'].sum()}\")\n",
    "    print(f\"Dynamic + synced             : {(df['is_dynamic'] & df['is_synced']).sum()}\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. 1/3 Trajectory Sync Analysis\n",
    "Check partial sync — genes where only early, middle, or late window is synced."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def split_trajectory_windows(traj, n_windows=3):\n",
    "    \"\"\"\n",
    "    Split trajectory into n equal windows.\n",
    "    For 6 timepoints: early=[0:2], mid=[2:4], late=[4:6]\n",
    "    \"\"\"\n",
    "    n   = len(traj)\n",
    "    size = n // n_windows\n",
    "    return [\n",
    "        traj[i*size : (i+1)*size]\n",
    "        for i in range(n_windows)\n",
    "    ]\n",
    "\n",
    "\n",
    "window_labels = [\"early\", \"mid\", \"late\"]\n",
    "\n",
    "print(\"Computing 1/3 window sync analysis...\\n\")\n",
    "partial_sync_results = {}\n",
    "\n",
    "for pct in PERCENTILES:\n",
    "    npc_bin  = binary[pct][\"npc\"].dropna()\n",
    "    lvet_bin = binary[pct][\"lvet\"].dropna()\n",
    "    common   = npc_bin.index.intersection(lvet_bin.index)\n",
    "\n",
    "    rows = []\n",
    "    for gene in common:\n",
    "        npc_traj  = tuple(int(v) for v in npc_bin.loc[gene,  available_tp])\n",
    "        lvet_traj = tuple(int(v) for v in lvet_bin.loc[gene, available_tp])\n",
    "\n",
    "        npc_windows  = split_trajectory_windows(npc_traj)\n",
    "        lvet_windows = split_trajectory_windows(lvet_traj)\n",
    "\n",
    "        window_sync = {}\n",
    "        for i, label in enumerate(window_labels):\n",
    "            h = hamming(npc_windows[i], lvet_windows[i])\n",
    "            # Each window is 2 timepoints long, allow 0 mismatch for strict\n",
    "            window_sync[label] = (h == 0)\n",
    "\n",
    "        n_synced_windows = sum(window_sync.values())\n",
    "        synced_windows   = [l for l, s in window_sync.items() if s]\n",
    "\n",
    "        # Classify partial sync pattern\n",
    "        if n_synced_windows == 3:\n",
    "            pattern = \"FULL_SYNC\"\n",
    "        elif n_synced_windows == 0:\n",
    "            pattern = \"FULL_ASYNC\"\n",
    "        elif synced_windows == [\"early\"]:\n",
    "            pattern = \"EARLY_ONLY\"   # NPC programs early, LVET diverges\n",
    "        elif synced_windows == [\"late\"]:\n",
    "            pattern = \"LATE_ONLY\"    # diverges then re-converges\n",
    "        elif synced_windows == [\"mid\"]:\n",
    "            pattern = \"MID_ONLY\"\n",
    "        elif \"early\" in synced_windows and \"mid\" in synced_windows:\n",
    "            pattern = \"EARLY_MID\"    # synced then diverges at end\n",
    "        elif \"mid\" in synced_windows and \"late\" in synced_windows:\n",
    "            pattern = \"MID_LATE\"     # diverges then re-syncs\n",
    "        else:\n",
    "            pattern = \"EARLY_LATE\"   # synced at ends, different in middle\n",
    "\n",
    "        rows.append({\n",
    "            \"gene\"             : gene,\n",
    "            \"npc_trajectory\"   : \"→\".join(str(s) for s in npc_traj),\n",
    "            \"lvet_trajectory\"  : \"→\".join(str(s) for s in lvet_traj),\n",
    "            \"early_sync\"       : window_sync[\"early\"],\n",
    "            \"mid_sync\"         : window_sync[\"mid\"],\n",
    "            \"late_sync\"        : window_sync[\"late\"],\n",
    "            \"n_synced_windows\" : n_synced_windows,\n",
    "            \"sync_pattern\"     : pattern,\n",
    "            \"percentile\"       : pct,\n",
    "        })\n",
    "\n",
    "    df = pd.DataFrame(rows)\n",
    "    partial_sync_results[pct] = df\n",
    "\n",
    "    print(f\"pct={pct}th — Partial sync patterns:\")\n",
    "    print(df[\"sync_pattern\"].value_counts().to_string())\n",
    "    print()"
   ]
  },
