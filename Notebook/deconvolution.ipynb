   "source": [
    "## 11. Correlation: RNA vs Epigenetic Proportions\n",
    "Check if RNA and epigenetic deconvolution give consistent Layer V ET proportions.\n",
    "High correlation = reliable signal. Low correlation = modality-specific discordance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from scipy.stats import spearmanr\n",
    "\n",
    "shared_tp = sorted(set(rna_props.columns) & set(epi_props.columns))\n",
    "shared_ct = sorted(set(rna_props.index)   & set(epi_props.index))\n",
    "\n",
    "print(\"RNA vs Epigenetic proportion correlation per cell type:\")\n",
    "print(f\"{'Cell Type':<30} {'Spearman r':>12} {'p-value':>10}\")\n",
    "print(\"-\"*55)\n",
    "\n",
    "corr_rows = []\n",
    "for ct in shared_ct:\n",
    "    rna_v = rna_props.loc[ct, shared_tp].values\n",
    "    epi_v = epi_props.loc[ct, shared_tp].values\n",
    "    if np.std(rna_v) < 1e-6 or np.std(epi_v) < 1e-6:\n",
    "        r, p = np.nan, np.nan\n",
    "    else:\n",
    "        r, p = spearmanr(rna_v, epi_v)\n",
    "    print(f\"  {ct:<28} {r:>12.3f} {p:>10.4f}\")\n",
    "    corr_rows.append({\"cell_type\": ct, \"spearman_r\": r, \"p_value\": p})\n",
    "\n",
    "corr_df = pd.DataFrame(corr_rows)\n",
    "corr_df.to_csv(OUT_DIR / \"RNA_EPI_proportion_correlation.csv\", index=False)\n",
    "\n",
    "lvet_r = corr_df[corr_df[\"cell_type\"] == LAYER_V_ET][\"spearman_r\"].values\n",
    "if len(lvet_r) > 0:\n",
    "    print(f\"\\nLayer V ET RNA-EPI correlation: r={lvet_r[0]:.3f}\")\n",
    "    if lvet_r[0] < 0.5:\n",
    "        print(\"[NOTE] Low correlation — RNA and epigenetic deconvolutions disagree.\")\n",
    "        print(\"       This itself is biologically interesting: Layer V ET proportion\")\n",
    "        print(\"       estimated differently by transcriptome vs chromatin state.\")"
   ]
