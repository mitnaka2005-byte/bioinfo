{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Deconvolution of Bulk RNA-seq and ATAC-seq\n",
    "## Using h5ad Single-Cell Reference to Estimate Cell Type Proportions\n",
    "\n",
    "**What this notebook does:**\n",
    "1. Builds cell type signature matrices from h5ad scRNA-seq and CGN/CHN methylation references\n",
    "2. Deconvolves spinal cord bulk RNA-seq → estimates Layer V ET proportion per timepoint\n",
    "3. Deconvolves spinal cord bulk ATAC-seq → estimates chromatin state per cell type per timepoint\n",
    "4. Outputs corrected pure Layer V ET matrices for use in Notebooks 3 and 5\n",
    "5. QC plots of estimated cell type proportions across timepoints\n",
    "\n",
    "**Method:** Non-Negative Least Squares (NNLS) regression\n",
    "- Interpretable, no black-box assumptions\n",
    "- Works well when reference and bulk are from related tissue\n",
    "- Proportions sum to 1 per sample\n",
    "\n",
    "**Important caveat:**\n",
    "Spinal cord SRRs use ChatCre/HB9GFP drivers → mostly motor neuron enriched.\n",
    "Non-neuron proportions will be near zero. Main value = separating Layer V ET\n",
    "from other deep layer subtypes within the motor neuron fraction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import scanpy as sc\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from scipy.optimize import nnls\n",
    "from scipy.sparse import issparse\n",
    "from scipy.stats import zscore\n",
    "\n",
    "sc.settings.verbosity = 1\n",
    "pd.set_option('display.max_columns', 20)\n",
    "pd.set_option('display.max_rows', 60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Paths ─────────────────────────────────────────────────────────────────────\n",
    "H5AD_RNA_PATH  = \"/home/nakagawa/datasets/h5ad/SMARTer_cells_MOp.h5ad\"\n",
    "H5AD_CGN_PATH  = \"/home/nakagawa/datasets/h5ad/DNA_Methylation_CGN.h5ad\"\n",
    "H5AD_CHN_PATH  = \"/home/nakagawa/datasets/h5ad/DNA_Methylation_CHN.h5ad\"\n",
    "SPINAL_RNA_DIR = Path(\"/home/nakagawa/datasets/aligned_spinalcord/rna\")\n",
    "SPINAL_ATAC_DIR= Path(\"/home/nakagawa/datasets/aligned_spinalcord/atac\")\n",
    "\n",
    "# Output — corrected matrices go here for use in Notebooks 3 and 5\n",
    "OUT_DIR        = Path(\"/home/nakagawa/datasets/deconvolution_results\")\n",
    "CORRECTED_DIR  = Path(\"/home/nakagawa/datasets/deconvolved_matrices\")\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "CORRECTED_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ── Cell type config ──────────────────────────────────────────────────────────\n",
    "CT_COL     = \"cell_type\"\n",
    "LAYER_V_ET = \"L5 ET\"\n",
    "\n",
    "NON_NEURON_TYPES       = [\"Astrocyte\", \"Microglia\", \"Oligodendrocyte\",\n",
    "                           \"OPC\", \"Endothelial\", \"VLMC\"]\n",
    "UPPER_LAYER_TYPES      = [\"L2/3 IT\", \"L4 IT\"]\n",
    "OTHER_DEEP_LAYER_TYPES = [\"L5 IT\", \"L5/6 NP\", \"L6 IT\", \"L6 CT\", \"L6b\"]\n",
    "\n",
    "# ── Signature matrix parameters ───────────────────────────────────────────────\n",
    "N_MARKER_GENES  = 50    # top N marker genes per cell type for signature\n",
    "MIN_FOLD_CHANGE = 2.0   # minimum fold change vs mean of others\n",
    "MIN_EXPR        = 1.0   # minimum mean CPM in the cell type\n",
    "\n",
    "# ── Timepoints ────────────────────────────────────────────────────────────────\n",
    "SPINAL_TIMEPOINTS = [\"E10.5\", \"E13.5\", \"P4\", \"P13\", \"P21\", \"P56\", \"2yr\"]\n",
    "\n",
    "SRR_TO_TP = {\n",
    "    \"SRR18338966\": \"2yr\",   \"SRR18338967\": \"2yr\",\n",
    "    \"SRR18338968\": \"P56\",   \"SRR18338969\": \"P56\",   \"SRR18338970\": \"P56\",\n",
    "    \"SRR18338971\": \"P21\",   \"SRR18338972\": \"P21\",   \"SRR18338973\": \"P21\",\n",
    "    \"SRR18338974\": \"P13\",   \"SRR18338975\": \"P13\",\n",
    "    \"SRR18338976\": \"P4\",    \"SRR18338977\": \"P4\",    \"SRR18338978\": \"P4\",\n",
    "    \"SRR18338979\": \"E13.5\", \"SRR18338980\": \"E13.5\",\n",
    "    \"SRR18338981\": \"E10.5\", \"SRR18338982\": \"E10.5\", \"SRR18338983\": \"E10.5\",\n",
    "}\n",
    "\n",
    "print(\"Configuration set.\")\n",
    "print(f\"Marker genes per cell type : {N_MARKER_GENES}\")\n",
    "print(f\"Min fold change            : {MIN_FOLD_CHANGE}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load h5ad Reference and Inspect Cell Types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Loading h5ad reference files...\")\n",
    "adata_rna = sc.read_h5ad(H5AD_RNA_PATH)\n",
    "adata_cgn = sc.read_h5ad(H5AD_CGN_PATH)\n",
    "adata_chn = sc.read_h5ad(H5AD_CHN_PATH)\n",
    "\n",
    "print(f\"RNA : {adata_rna.shape}\")\n",
    "print(f\"CGN : {adata_cgn.shape}\")\n",
    "print(f\"CHN : {adata_chn.shape}\")\n",
    "\n",
    "# Collect all available cell types\n",
    "all_ct = sorted(adata_rna.obs[CT_COL].unique())\n",
    "print(f\"\\nCell types in RNA reference ({len(all_ct)}):\")\n",
    "for ct in all_ct:\n",
    "    n = (adata_rna.obs[CT_COL] == ct).sum()\n",
    "    print(f\"  {ct:<30} n={n}\")\n",
    "\n",
    "# Filter to cell types in our analysis groups\n",
    "TARGET_CTS = [LAYER_V_ET] + NON_NEURON_TYPES + UPPER_LAYER_TYPES + OTHER_DEEP_LAYER_TYPES\n",
    "TARGET_CTS = [ct for ct in TARGET_CTS if ct in all_ct]\n",
    "print(f\"\\nTarget cell types for deconvolution: {len(TARGET_CTS)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Build RNA Signature Matrix\n",
    "Select top N marker genes per cell type using fold change vs all others.\n",
    "Signature matrix = genes × cell_types (mean CPM per cell type for marker genes)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_pseudobulk_cpm(adata, ct_col, cell_types):\n",
    "    \"\"\"Mean CPM per cell type. Returns DataFrame: genes x cell_types.\"\"\"\n",
    "    # Normalize to CPM first\n",
    "    a = adata.copy()\n",
    "    if a.raw is not None:\n",
    "        a = a.raw.to_adata()\n",
    "    sc.pp.normalize_total(a, target_sum=1e6)  # CPM\n",
    "    a.obs[ct_col] = adata.obs[ct_col]\n",
    "\n",
    "    result = {}\n",
    "    for ct in cell_types:\n",
    "        mask = a.obs[ct_col] == ct\n",
    "        sub  = a[mask]\n",
    "        X    = sub.X.toarray() if issparse(sub.X) else np.array(sub.X)\n",
    "        result[ct] = X.mean(axis=0)\n",
    "    return pd.DataFrame(result, index=a.var_names)  # genes x cell_types\n",
    "\n",
    "\n",
    "def select_marker_genes(pb_cpm, target_ct, all_cts,\n",
    "                         n_markers, min_fc, min_expr):\n",
    "    \"\"\"\n",
    "    Select top marker genes for target_ct vs all others.\n",
    "    Criteria:\n",
    "      - Mean CPM in target > min_expr\n",
    "      - Fold change vs mean of others >= min_fc\n",
    "      - Ranked by fold change, take top n_markers\n",
    "    \"\"\"\n",
    "    other_cts   = [ct for ct in all_cts if ct != target_ct]\n",
    "    target_expr = pb_cpm[target_ct]\n",
    "    other_mean  = pb_cpm[other_cts].mean(axis=1)\n",
    "\n",
    "    fc = target_expr / (other_mean + 1e-3)\n",
    "\n",
    "    mask = (target_expr >= min_expr) & (fc >= min_fc)\n",
    "    candidates = fc[mask].sort_values(ascending=False)\n",
    "    return candidates.head(n_markers).index.tolist()\n",
    "\n",
    "\n",
    "print(\"Building RNA pseudobulk CPM matrix...\")\n",
    "pb_rna = get_pseudobulk_cpm(adata_rna, CT_COL, TARGET_CTS)\n",
    "print(f\"  Pseudobulk shape: {pb_rna.shape}\")\n",
    "\n",
    "print(\"\\nSelecting marker genes per cell type...\")\n",
    "all_markers_rna = {}\n",
    "for ct in TARGET_CTS:\n",
    "    markers = select_marker_genes(\n",
    "        pb_rna, ct, TARGET_CTS, N_MARKER_GENES, MIN_FOLD_CHANGE, MIN_EXPR\n",
    "    )\n",
    "    all_markers_rna[ct] = markers\n",
    "    print(f\"  {ct:<30}: {len(markers)} markers\")\n",
    "\n",
    "# Union of all marker genes\n",
    "marker_union = sorted(set(\n",
    "    g for markers in all_markers_rna.values() for g in markers\n",
    "))\n",
    "print(f\"\\nTotal unique marker genes: {len(marker_union)}\")\n",
    "\n",
    "# Build signature matrix: marker_genes x cell_types\n",
    "sig_rna = pb_rna.loc[marker_union, TARGET_CTS].copy()\n",
    "\n",
    "# Log-scale for better numerical properties in NNLS\n",
    "sig_rna_log = np.log1p(sig_rna)\n",
    "\n",
    "print(f\"RNA signature matrix: {sig_rna.shape}  (marker genes x cell types)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Build Epigenetic Signature Matrix (CGN + CHN)\n",
    "Methylation fractions are already on 0-1 scale — use directly without CPM."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_methylation_pseudobulk(adata, ct_col, cell_types):\n",
    "    \"\"\"Mean methylation fraction per cell type. Returns genes x cell_types.\"\"\"\n",
    "    result = {}\n",
    "    for ct in cell_types:\n",
    "        mask = adata.obs[ct_col] == ct\n",
    "        if mask.sum() == 0:\n",
    "            continue\n",
    "        sub = adata[mask]\n",
    "        X   = sub.X.toarray() if issparse(sub.X) else np.array(sub.X)\n",
    "        result[ct] = X.mean(axis=0)\n",
    "    return pd.DataFrame(result, index=adata.var_names)\n",
    "\n",
    "\n",
    "print(\"Building methylation pseudobulk matrices...\")\n",
    "\n",
    "# Filter CGN/CHN to cell types available in both\n",
    "cgn_cts = [ct for ct in TARGET_CTS\n",
    "           if ct in adata_cgn.obs[CT_COL].values]\n",
    "chn_cts = [ct for ct in TARGET_CTS\n",
    "           if ct in adata_chn.obs[CT_COL].values]\n",
    "\n",
    "pb_cgn = get_methylation_pseudobulk(adata_cgn, CT_COL, cgn_cts)\n",
    "pb_chn = get_methylation_pseudobulk(adata_chn, CT_COL, chn_cts)\n",
    "print(f\"  CGN pseudobulk : {pb_cgn.shape}\")\n",
    "print(f\"  CHN pseudobulk : {pb_chn.shape}\")\n",
    "\n",
    "# Align cell types\n",
    "shared_epi_cts = sorted(set(pb_cgn.columns) & set(pb_chn.columns))\n",
    "pb_cgn = pb_cgn[shared_epi_cts]\n",
    "pb_chn = pb_chn[shared_epi_cts]\n",
    "\n",
    "# Combined epigenetic pseudobulk (weighted)\n",
    "ALPHA, BETA = 0.6, 0.4\n",
    "common_epi_genes = pb_cgn.index.intersection(pb_chn.index)\n",
    "pb_epi = ALPHA * pb_cgn.loc[common_epi_genes] + BETA * pb_chn.loc[common_epi_genes]\n",
    "\n",
    "# Select marker genes for epigenetic signature\n",
    "print(\"\\nSelecting epigenetic marker genes per cell type...\")\n",
    "all_markers_epi = {}\n",
    "for ct in shared_epi_cts:\n",
    "    markers = select_marker_genes(\n",
    "        pb_epi, ct, shared_epi_cts,\n",
    "        N_MARKER_GENES, min_fc=1.5, min_expr=0.1\n",
    "    )\n",
    "    all_markers_epi[ct] = markers\n",
    "    print(f\"  {ct:<30}: {len(markers)} markers\")\n",
    "\n",
    "epi_marker_union = sorted(set(\n",
    "    g for m in all_markers_epi.values() for g in m\n",
    "))\n",
    "sig_epi = pb_epi.loc[epi_marker_union, shared_epi_cts]\n",
    "print(f\"\\nEpigenetic signature matrix: {sig_epi.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Load Spinal Cord Bulk RNA Per Timepoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_star_bulk(tab_path):\n",
    "    df = pd.read_csv(tab_path, sep=\"\\t\", header=None,\n",
    "                     names=[\"gene\",\"unstranded\",\"forward\",\"reverse\"],\n",
    "                     skiprows=4)\n",
    "    return df.set_index(\"gene\")[\"reverse\"]\n",
    "\n",
    "\n",
    "print(\"Loading spinal cord bulk RNA...\")\n",
    "tp_raw = {}   # {tp: [Series, ...]}\n",
    "\n",
    "for sample_dir in sorted(SPINAL_RNA_DIR.iterdir()):\n",
    "    if not sample_dir.is_dir(): continue\n",
    "    tab = sample_dir / \"ReadsPerGene.out.tab\"\n",
    "    if not tab.exists(): continue\n",
    "    srr = next((s for s in SRR_TO_TP if s in sample_dir.name), None)\n",
    "    if srr is None: continue\n",
    "    tp  = SRR_TO_TP[srr]\n",
    "    tp_raw.setdefault(tp, []).append(load_star_bulk(tab))\n",
    "    print(f\"  {sample_dir.name} → {tp}\")\n",
    "\n",
    "# Average replicates, CPM normalize per timepoint\n",
    "bulk_cpm = {}\n",
    "for tp, reps in tp_raw.items():\n",
    "    merged = pd.concat(reps, axis=1).fillna(0).mean(axis=1)\n",
    "    bulk_cpm[tp] = np.log1p(merged / merged.sum() * 1e6)\n",
    "\n",
    "bulk_mat = pd.DataFrame(bulk_cpm).fillna(0)  # genes x timepoints\n",
    "print(f\"\\nBulk RNA matrix: {bulk_mat.shape}\")\n",
    "print(f\"Timepoints: {list(bulk_mat.columns)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Load Spinal Cord Bulk ATAC Per Timepoint\n",
    "Use gene-level ATAC scores (signal over gene body ± 2kb) from narrowPeak files."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "GTF_PATH = \"/home/nakagawa/datasets/genome/mm10/Mus_musculus.GRCm38.84.gtf\"\n",
    "\n",
    "def parse_gtf_genes(gtf_path, extend_promoter=2000):\n",
    "    rows = []\n",
    "    with open(gtf_path) as f:\n",
    "        for line in f:\n",
    "            if line.startswith(\"#\"): continue\n",
    "            parts = line.strip().split(\"\\t\")\n",
    "            if parts[2] != \"gene\": continue\n",
    "            info = parts[8]\n",
    "            name = next(\n",
    "                (f.split('\"')[1] for f in info.split(\";\")\n",
    "                 if f.strip().startswith(\"gene_name\")), None\n",
    "            )\n",
    "            if name is None: continue\n",
    "            rows.append({\n",
    "                \"gene\" : name,\n",
    "                \"chr\"  : parts[0],\n",
    "                \"start\": max(0, int(parts[3]) - 1 - extend_promoter),\n",
    "                \"end\"  : int(parts[4]) + extend_promoter,\n",
    "            })\n",
    "    return pd.DataFrame(rows).drop_duplicates(subset=\"gene\")\n",
    "\n",
    "\n",
    "def peaks_to_gene_scores(peaks_df, gene_windows):\n",
    "    scores = {}\n",
    "    for _, gw in gene_windows.iterrows():\n",
    "        ov = peaks_df[\n",
    "            (peaks_df[\"chr\"] == gw[\"chr\"]) &\n",
    "            (peaks_df[\"start\"] < gw[\"end\"]) &\n",
    "            (peaks_df[\"end\"] > gw[\"start\"])\n",
    "        ]\n",
    "        scores[gw[\"gene\"]] = ov[\"signalValue\"].sum()\n",
    "    return pd.Series(scores)\n",
    "\n",
    "\n",
    "print(\"Parsing GTF gene windows...\")\n",
    "gene_windows = parse_gtf_genes(GTF_PATH)\n",
    "print(f\"  Gene windows: {len(gene_windows)}\")\n",
    "\n",
    "ATAC_SRR_TO_TP = {\n",
    "    \"SRR18338984\": \"2yr\",   \"SRR18338985\": \"2yr\",\n",
    "    \"SRR18338986\": \"P56\",   \"SRR18338987\": \"P56\",\n",
    "    \"SRR18338988\": \"P21\",   \"SRR18338989\": \"P21\",\n",
    "    \"SRR18338990\": \"P13\",   \"SRR18338991\": \"P13\",\n",
    "    \"SRR18338992\": \"P4\",    \"SRR18338993\": \"P4\",\n",
    "    \"SRR18338994\": \"E13.5\", \"SRR18338995\": \"E13.5\",\n",
    "    \"SRR18338996\": \"E10.5\", \"SRR18338997\": \"E10.5\",\n",
    "}\n",
    "\n",
    "print(\"\\nLoading ATAC narrowPeak files...\")\n",
    "atac_tp_raw = {}\n",
    "for sample_dir in sorted(SPINAL_ATAC_DIR.iterdir()):\n",
    "    if not sample_dir.is_dir(): continue\n",
    "    peaks_files = list(sample_dir.glob(\"*_peaks.narrowPeak\"))\n",
    "    if not peaks_files: continue\n",
    "    srr = next((s for s in ATAC_SRR_TO_TP if s in sample_dir.name), None)\n",
    "    if srr is None: continue\n",
    "    tp  = ATAC_SRR_TO_TP[srr]\n",
    "    cols = [\"chr\",\"start\",\"end\",\"name\",\"score\",\"strand\",\n",
    "            \"signalValue\",\"pValue\",\"qValue\",\"peak\"]\n",
    "    peaks_df = pd.read_csv(peaks_files[0], sep=\"\\t\",\n",
    "                           header=None, names=cols)\n",
    "    scores = peaks_to_gene_scores(peaks_df, gene_windows)\n",
    "    atac_tp_raw.setdefault(tp, []).append(scores)\n",
    "    print(f\"  {sample_dir.name} → {tp}: {len(peaks_df)} peaks\")\n",
    "\n",
    "# Average replicates\n",
    "atac_mat = pd.DataFrame({\n",
    "    tp: pd.concat(reps, axis=1).fillna(0).mean(axis=1)\n",
    "    for tp, reps in atac_tp_raw.items()\n",
    "}).fillna(0)\n",
    "print(f\"\\nATAC matrix: {atac_mat.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. NNLS Deconvolution — Core Function\n",
    "\n",
    "```\n",
    "bulk_sample = Signature_matrix × proportions + noise\n",
    "NNLS solves: min ||bulk - Sig × p||² subject to p >= 0\n",
    "Then normalize p to sum to 1 → cell type proportions\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def deconvolve_sample(bulk_vector, sig_matrix):\n",
    "    \"\"\"\n",
    "    NNLS deconvolution of one bulk sample.\n",
    "\n",
    "    Args:\n",
    "        bulk_vector : Series (genes,) — bulk expression for one sample\n",
    "        sig_matrix  : DataFrame (genes x cell_types) — reference signatures\n",
    "\n",
    "    Returns:\n",
    "        proportions : Series (cell_types,) summing to 1\n",
    "        residual    : float — reconstruction error (lower = better fit)\n",
    "    \"\"\"\n",
    "    # Align genes\n",
    "    common = sig_matrix.index.intersection(bulk_vector.index)\n",
    "    sig    = sig_matrix.loc[common].values   # genes x cell_types\n",
    "    bulk   = bulk_vector.loc[common].values  # genes\n",
    "\n",
    "    # Z-score both to same scale\n",
    "    bulk_z = zscore(bulk)\n",
    "    sig_z  = (sig - sig.mean(axis=0, keepdims=True)) / \\\n",
    "             (sig.std(axis=0, keepdims=True) + 1e-9)\n",
    "\n",
    "    # NNLS\n",
    "    props, residual = nnls(sig_z, bulk_z)\n",
    "\n",
    "    # Normalize to sum to 1\n",
    "    total = props.sum()\n",
    "    if total > 0:\n",
    "        props = props / total\n",
    "\n",
    "    return pd.Series(props, index=sig_matrix.columns), residual\n",
    "\n",
    "\n",
    "def deconvolve_all_timepoints(bulk_mat, sig_matrix, timepoints):\n",
    "    \"\"\"\n",
    "    Deconvolve all timepoints.\n",
    "    Returns:\n",
    "        props_df  : DataFrame (cell_types x timepoints) — proportions\n",
    "        resid_df  : Series (timepoints) — residuals per timepoint\n",
    "    \"\"\"\n",
    "    props_all  = {}\n",
    "    resid_all  = {}\n",
    "    for tp in timepoints:\n",
    "        if tp not in bulk_mat.columns:\n",
    "            print(f\"  [SKIP] {tp} not in bulk data\")\n",
    "            continue\n",
    "        props, resid = deconvolve_sample(bulk_mat[tp], sig_matrix)\n",
    "        props_all[tp] = props\n",
    "        resid_all[tp] = resid\n",
    "        print(f\"  {tp:<8}: residual={resid:.4f}  \"\n",
    "              f\"top_ct={props.idxmax()} ({props.max():.2%})\")\n",
    "    return pd.DataFrame(props_all), pd.Series(resid_all)\n",
    "\n",
    "\n",
    "print(\"Function defined. Running deconvolution in next cells.\")"
   ]
  },
