  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Compute Deconvolved Pure Layer V ET Signal\n",
    "\n",
    "Reconstruct estimated pure Layer V ET expression at each timepoint:\n",
    "```\n",
    "LayerVET_pure(t) = [bulk(t) - Σ_other_ct (prop(ct,t) × sig(ct))] / prop(LayerVET, t)\n",
    "```\n",
    "This is the corrected matrix to replace spinal_rna_matrix in Notebooks 3 and 5."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_pure_signal(bulk_mat, sig_matrix, props_df,\n",
    "                         target_ct, timepoints):\n",
    "    \"\"\"\n",
    "    Estimate pure target cell type signal by subtracting\n",
    "    contribution of all other cell types from bulk.\n",
    "\n",
    "    Returns DataFrame: genes x timepoints (pure target signal)\n",
    "    \"\"\"\n",
    "    common_genes = bulk_mat.index.intersection(sig_matrix.index)\n",
    "    other_cts    = [ct for ct in sig_matrix.columns if ct != target_ct]\n",
    "    result       = {}\n",
    "\n",
    "    for tp in timepoints:\n",
    "        if tp not in bulk_mat.columns or tp not in props_df.columns:\n",
    "            continue\n",
    "\n",
    "        bulk_tp = bulk_mat.loc[common_genes, tp].values\n",
    "\n",
    "        # Subtract other cell type contributions\n",
    "        other_contrib = np.zeros(len(common_genes))\n",
    "        for ct in other_cts:\n",
    "            if ct not in props_df.index or ct not in sig_matrix.columns:\n",
    "                continue\n",
    "            prop = props_df.loc[ct, tp]\n",
    "            sig  = sig_matrix.loc[common_genes, ct].values\n",
    "            # Normalize sig to same scale as bulk\n",
    "            sig_scaled = sig / (sig.mean() + 1e-9) * bulk_tp.mean()\n",
    "            other_contrib += prop * sig_scaled\n",
    "\n",
    "        # Residual = estimated Layer V ET contribution\n",
    "        lvet_prop   = props_df.loc[target_ct, tp] if target_ct in props_df.index else 0\n",
    "        pure_signal = bulk_tp - other_contrib\n",
    "\n",
    "        # Rescale by proportion (higher proportion → more confident estimate)\n",
    "        if lvet_prop > 0.05:   # only trust if proportion is meaningful\n",
    "            pure_signal = pure_signal / lvet_prop\n",
    "\n",
    "        # Clip negatives (noise artifact)\n",
    "        pure_signal = np.clip(pure_signal, 0, None)\n",
    "        result[tp]  = pure_signal\n",
    "\n",
    "    return pd.DataFrame(result, index=common_genes)\n",
    "\n",
    "\n",
    "print(\"Extracting pure Layer V ET RNA signal...\")\n",
    "lvet_rna_pure = extract_pure_signal(\n",
    "    bulk_mat, sig_rna_log, rna_props, LAYER_V_ET, available_tp\n",
    ")\n",
    "print(f\"  Pure LVET RNA matrix: {lvet_rna_pure.shape}\")\n",
    "\n",
    "print(\"\\nExtracting pure Layer V ET epigenetic signal...\")\n",
    "lvet_epi_pure = extract_pure_signal(\n",
    "    atac_log, sig_epi, epi_props, LAYER_V_ET,\n",
    "    [t for t in atac_tp if t in epi_props.columns]\n",
    ")\n",
    "print(f\"  Pure LVET EPI matrix: {lvet_epi_pure.shape}\")\n",
    "\n",
    "# Save corrected matrices — these replace the uncorrected ones in Notebooks 3 and 5\n",
    "lvet_rna_pure.to_csv(CORRECTED_DIR / \"lvet_pure_RNA_spinal.csv\")\n",
    "lvet_epi_pure.to_csv(CORRECTED_DIR / \"lvet_pure_EPI_spinal.csv\")\n",
    "rna_props.to_csv(    CORRECTED_DIR / \"rna_celltype_props_per_tp.csv\")\n",
    "epi_props.to_csv(    CORRECTED_DIR / \"epi_celltype_props_per_tp.csv\")\n",
    "\n",
    "print(f\"\\nCorrected matrices saved to {CORRECTED_DIR}/\")\n",
    "print(\"→ Use these in Notebooks 3 and 5 (see patch cells below)\")"
   ]
