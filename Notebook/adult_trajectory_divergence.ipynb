   "outputs": [],
   "source": [
    "preview_cols = [\"gene\", \"shape\", \"early_slope\", \"late_slope\",\n",
    "                \"mean_drift_dev\", \"late_drift_dev\", \"traj_range\"]\n",
    "\n",
    "print(\"=== TOP 20 IDENTITY MAINTENANCE GENES ===\")\n",
    "display(maintenance[preview_cols].head(20).reset_index(drop=True))\n",
    "\n",
    "print(\"\\n=== TOP 20 AGING VULNERABILITY GENES ===\")\n",
    "display(aging_vuln[preview_cols].head(20).reset_index(drop=True))\n",
    "\n",
    "print(\"\\n=== TOP 20 PROGRESSIVE LOSS GENES ===\")\n",
    "display(prog_loss[preview_cols].head(20).reset_index(drop=True))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "# TRACK B — Option A: Multi-Cell-Type Deep Dive\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1B. Load h5ad Files and Build Pseudobulk Per Cell Type"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Loading h5ad files...\")\n",
    "adata_rna = sc.read_h5ad(H5AD_RNA_PATH)\n",
    "adata_cgn = sc.read_h5ad(H5AD_CGN_PATH)\n",
    "adata_chn = sc.read_h5ad(H5AD_CHN_PATH)\n",
    "\n",
    "print(f\"RNA : {adata_rna.shape}\")\n",
    "print(f\"CGN : {adata_cgn.shape}\")\n",
    "print(f\"CHN : {adata_chn.shape}\")\n",
    "\n",
    "# Print available metadata columns\n",
    "print(\"\\nRNA obs columns:\", adata_rna.obs.columns.tolist())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── EDIT CT_COL in Cell 0 if needed after checking above ─────────────────────\n",
    "\n",
    "ALL_CT = [LAYER_V_ET] + NON_NEURON_TYPES + UPPER_LAYER_TYPES + OTHER_DEEP_LAYER_TYPES\n",
    "ALL_CT = [ct for ct in ALL_CT\n",
    "          if ct in adata_rna.obs[CT_COL].values]\n",
    "\n",
    "print(f\"Working with {len(ALL_CT)} cell types:\")\n",
    "for ct in ALL_CT:\n",
    "    n = (adata_rna.obs[CT_COL] == ct).sum()\n",
    "    print(f\"  {ct:<25} n={n}\")\n",
    "\n",
    "\n",
    "def pseudobulk_mean(adata, ct_col, cell_types, normalize=True):\n",
    "    \"\"\"\n",
    "    Pseudobulk mean expression per cell type.\n",
    "    Returns DataFrame: genes x cell_types.\n",
    "    \"\"\"\n",
    "    result = {}\n",
    "    for ct in cell_types:\n",
    "        mask = adata.obs[ct_col] == ct\n",
    "        sub  = adata[mask]\n",
    "        X    = sub.X.toarray() if issparse(sub.X) else np.array(sub.X)\n",
    "        result[ct] = X.mean(axis=0)\n",
    "    df = pd.DataFrame(result, index=adata.var_names)\n",
    "    if normalize:\n",
    "        df = df.div(df.sum(axis=0), axis=1) * 1e6  # CPM\n",
    "    return df\n",
    "\n",
    "\n",
    "print(\"\\nBuilding pseudobulk matrices...\")\n",
    "\n",
    "# RNA\n",
    "adata_rna_use = adata_rna.raw.to_adata() if adata_rna.raw else adata_rna.copy()\n",
    "adata_rna_use.obs[CT_COL] = adata_rna.obs[CT_COL]\n",
    "pb_rna = pseudobulk_mean(adata_rna_use, CT_COL, ALL_CT, normalize=True)\n",
    "print(f\"  RNA pseudobulk : {pb_rna.shape}\")\n",
    "\n",
    "# CGN methylation (fractions, no CPM normalization)\n",
    "pb_cgn = pseudobulk_mean(adata_cgn, CT_COL, ALL_CT, normalize=False)\n",
    "print(f\"  CGN pseudobulk : {pb_cgn.shape}\")\n",
    "\n",
    "# CHN methylation\n",
    "pb_chn = pseudobulk_mean(adata_chn, CT_COL, ALL_CT, normalize=False)\n",
    "print(f\"  CHN pseudobulk : {pb_chn.shape}\")\n",
    "\n",
    "# Align gene index across all three\n",
    "common_genes = pb_rna.index.intersection(pb_cgn.index).intersection(pb_chn.index)\n",
    "pb_rna = pb_rna.loc[common_genes]\n",
    "pb_cgn = pb_cgn.loc[common_genes]\n",
    "pb_chn = pb_chn.loc[common_genes]\n",
    "print(f\"\\nCommon genes: {len(common_genes)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2B. Z-score Normalize Across Cell Types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def zscore_across_ct(df):\n",
    "    \"\"\"Z-score each gene (row) across cell types (columns).\"\"\"\n",
    "    arr  = df.values.astype(float)\n",
    "    mu   = arr.mean(axis=1, keepdims=True)\n",
    "    sig  = arr.std(axis=1,  keepdims=True)\n",
    "    sig[sig == 0] = 1\n",
    "    return pd.DataFrame((arr - mu) / sig,\n",
    "                        index=df.index, columns=df.columns)\n",
    "\n",
    "z_rna = zscore_across_ct(pb_rna)\n",
    "z_cgn = zscore_across_ct(pb_cgn)\n",
    "z_chn = zscore_across_ct(pb_chn)\n",
    "\n",
    "# Combined epigenetic Z-score (weighted)\n",
    "ALPHA, BETA = 0.6, 0.4\n",
    "z_epi = ALPHA * z_cgn + BETA * z_chn\n",
    "\n",
    "print(\"Z-score ranges:\")\n",
    "for name, z in [(\"RNA\", z_rna), (\"CGN\", z_cgn),\n",
    "                (\"CHN\", z_chn), (\"EPI\", z_epi)]:\n",
    "    print(f\"  {name}: [{z.values.min():.2f}, {z.values.max():.2f}]\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3B. Compute Divergence Metrics Per Gene\n",
    "\n",
    "For each gene compute three metrics measuring how isolated Layer V ET is:\n",
    "- **EDC**: distance from centroid of all other cell types\n",
    "- **IS** : distance from nearest neighbour cell type\n",
    "- **RD** : percentile rank among all cell types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_divergence_metrics(z_df, target_ct, all_ct, percentile=PERCENTILE_THRESH):\n",
    "    \"\"\"\n",
    "    For each gene compute EDC, IS, RD for the target cell type\n",
    "    relative to all other cell types.\n",
    "\n",
    "    Returns DataFrame: genes x [EDC, IS, RD, nearest_ct]\n",
    "    \"\"\"\n",
    "    other_cts = [ct for ct in all_ct if ct != target_ct]\n",
    "    rows      = []\n",
    "\n",
    "    for gene in z_df.index:\n",
    "        target_val  = z_df.loc[gene, target_ct]\n",
    "        other_vals  = z_df.loc[gene, other_cts]\n",
    "\n",
    "        # EDC: absolute distance from mean of others\n",
    "        centroid    = other_vals.mean()\n",
    "        edc         = abs(target_val - centroid)\n",
    "\n",
    "        # IS: distance from nearest neighbour\n",
    "        dists       = (other_vals - target_val).abs()\n",
    "        is_score    = dists.min()\n",
    "        nearest_ct  = dists.idxmin()\n",
    "\n",
    "        # RD: percentile rank among all cell types\n",
    "        all_vals    = z_df.loc[gene, all_ct]\n",
    "        rd          = percentileofscore(all_vals, target_val)\n",
    "\n",
    "        rows.append({\n",
    "            \"gene\"      : gene,\n",
    "            \"EDC\"       : round(edc,       3),\n",
    "            \"IS\"        : round(is_score,  3),\n",
    "            \"RD\"        : round(rd,        1),\n",
    "            \"nearest_ct\": nearest_ct,\n",
    "            \"lvet_z\"    : round(target_val, 3),\n",
    "            \"centroid_z\": round(centroid,   3),\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(rows).set_index(\"gene\")\n",
    "\n",
    "\n",
    "from scipy.stats import percentileofscore\n",
    "\n",
    "print(\"Computing divergence metrics for RNA, CGN, CHN, EPI...\")\n",
    "div_rna = compute_divergence_metrics(z_rna, LAYER_V_ET, ALL_CT)\n",
    "div_cgn = compute_divergence_metrics(z_cgn, LAYER_V_ET, ALL_CT)\n",
    "div_chn = compute_divergence_metrics(z_chn, LAYER_V_ET, ALL_CT)\n",
    "div_epi = compute_divergence_metrics(z_epi, LAYER_V_ET, ALL_CT)\n",
    "\n",
    "print(f\"  EDC (RNA) mean={div_rna['EDC'].mean():.3f}  \"\n",
    "      f\"IS mean={div_rna['IS'].mean():.3f}  \"\n",
    "      f\"RD mean={div_rna['RD'].mean():.1f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4B. Compute Convergence Risk Score (CRS)\n",
    "\n",
    "```\n",
    "CRS_RNA = -sign(lvet_z) × (1/EDC) × (1/IS) × (1 - |RD-50|/50)\n",
    "```\n",
    "- **CRS > 0** → converging toward other cell types (identity loss risk)\n",
    "- **CRS < 0** → diverging away from other cell types (identity maintained)\n",
    "\n",
    "Also compute combined RNA + Epigenetic CRS."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_crs(div_df):\n",
    "    \"\"\"\n",
    "    Convergence Risk Score.\n",
    "    High positive = converging (losing identity).\n",
    "    High negative = diverging (maintaining/strengthening identity).\n",
    "    \"\"\"\n",
    "    edc    = div_df[\"EDC\"].clip(lower=0.01)\n",
    "    is_s   = div_df[\"IS\"].clip(lower=0.01)\n",
    "    rd     = div_df[\"RD\"]\n",
    "    lvet_z = div_df[\"lvet_z\"]\n",
    "\n",
    "    # Isolation term: high EDC + high IS = well isolated = low convergence risk\n",
    "    isolation = (edc * is_s).clip(lower=0.01)\n",
    "\n",
    "    # Rank centrality: RD near 50 = not extreme = converging toward average\n",
    "    rank_centrality = 1 - (rd - 50).abs() / 50\n",
    "\n",
    "    # CRS: positive when close to others AND near median rank\n",
    "    crs = rank_centrality / isolation\n",
    "\n",
    "    # Sign: negative CRS for genes that are uniquely high/low in Layer V ET\n",
    "    # (these are maintaining unique identity)\n",
    "    crs = crs * np.sign(rank_centrality - 0.5 + 1e-9) * -np.sign(lvet_z + 1e-9)\n",
    "\n",
    "    return crs.rename(\"CRS\")\n",
    "\n",
    "\n",
    "crs_rna = compute_crs(div_rna)\n",
    "crs_epi = compute_crs(div_epi)\n",
    "\n",
    "# Combined CRS weighted 50/50 RNA + EPI\n",
    "crs_combined = (0.5 * crs_rna + 0.5 * crs_epi).rename(\"CRS_combined\")\n",
    "\n",
    "# Assemble full results table\n",
    "deep_df = pd.DataFrame({\n",
    "    \"gene\"         : div_rna.index,\n",
    "    \"EDC_RNA\"      : div_rna[\"EDC\"].values,\n",
    "    \"IS_RNA\"       : div_rna[\"IS\"].values,\n",
    "    \"RD_RNA\"       : div_rna[\"RD\"].values,\n",
    "    \"EDC_EPI\"      : div_epi[\"EDC\"].values,\n",
    "    \"IS_EPI\"       : div_epi[\"IS\"].values,\n",
    "    \"RD_EPI\"       : div_epi[\"RD\"].values,\n",
    "    \"CRS_RNA\"      : crs_rna.values,\n",
    "    \"CRS_EPI\"      : crs_epi.values,\n",
    "    \"CRS_combined\" : crs_combined.values,\n",
    "    \"nearest_ct_RNA\": div_rna[\"nearest_ct\"].values,\n",
    "    \"nearest_ct_EPI\": div_epi[\"nearest_ct\"].values,\n",
    "    \"lvet_z_RNA\"   : div_rna[\"lvet_z\"].values,\n",
    "    \"lvet_z_EPI\"   : div_epi[\"lvet_z\"].values,\n",
    "}).set_index(\"gene\")\n",
    "\n",
    "# Classify\n",
    "deep_df[\"identity_status\"] = \"NEUTRAL\"\n",
    "deep_df.loc[deep_df[\"CRS_combined\"] < -CRS_THRESH, \"identity_status\"] = \"MAINTAINED\"\n",
    "deep_df.loc[deep_df[\"CRS_combined\"] >  CRS_THRESH, \"identity_status\"] = \"AT_RISK\"\n",
    "\n",
    "print(\"Identity status distribution:\")\n",
    "print(deep_df[\"identity_status\"].value_counts().to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5B. RNA vs Epigenetic Discordance in CRS\n",
    "Classify genes by whether RNA or epigenetic CRS are in agreement."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def crs_agreement(rna_crs, epi_crs, thresh=CRS_THRESH):\n",
    "    \"\"\"\n",
    "    Classify RNA/EPI CRS agreement into four categories.\n",
    "    \"\"\"\n",
    "    rna_maintained = rna_crs < -thresh\n",
    "    rna_at_risk    = rna_crs >  thresh\n",
    "    epi_maintained = epi_crs < -thresh\n",
    "    epi_at_risk    = epi_crs >  thresh\n",
    "\n",
    "    if rna_maintained and epi_maintained:\n",
    "        return \"BOTH_MAINTAINED\"\n",
    "    elif rna_at_risk   and epi_at_risk:\n",
    "        return \"BOTH_AT_RISK\"\n",
    "    elif rna_maintained and epi_at_risk:\n",
    "        # RNA maintained but epigenome drifting → chromatin losing identity first\n",
    "        return \"RNA_MAINTAINED_EPI_DRIFTING\"\n",
    "    elif rna_at_risk   and epi_maintained:\n",
    "        # Epigenome holds but RNA drifting → transcription losing identity first\n",
    "        return \"EPI_MAINTAINED_RNA_DRIFTING\"\n",
    "    else:\n",
    "        return \"NEUTRAL\"\n",
    "\n",
    "\n",
    "deep_df[\"crs_agreement\"] = [\n",
    "    crs_agreement(r, e)\n",
    "    for r, e in zip(deep_df[\"CRS_RNA\"], deep_df[\"CRS_EPI\"])\n",
    "]\n",
    "\n",
    "print(\"RNA vs Epigenetic CRS agreement:\")\n",
    "print(deep_df[\"crs_agreement\"].value_counts().to_string())\n",
    "print()\n",
    "print(\"Biological interpretation:\")\n",
    "print(\"  BOTH_MAINTAINED         → strong identity maintenance (both RNA + chromatin)\")\n",
    "print(\"  BOTH_AT_RISK            → progressive identity loss\")\n",
    "print(\"  RNA_MAINTAINED_EPI_DRIFTING → chromatin losing identity before transcription\")\n",
    "print(\"  EPI_MAINTAINED_RNA_DRIFTING → transcription losing identity before chromatin\")"
   ]
  },
  {
